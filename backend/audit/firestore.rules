rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function verifiedAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.uid == request.auth.uid;
    }

    /*
     * ADMIN ACCESS
     *
     * Each administrator must have:
     * admins/{THEIR_FIREBASE_UID}
     *
     * with:
     * {
     *   uid: "THEIR_FIREBASE_UID",
     *   isAdmin: true
     * }
     */

    match /admins/{adminUid} {

      // An authenticated user can only read their own valid admin record.
      allow get: if
        request.auth != null
        && request.auth.uid == adminUid
        && resource.data.uid == request.auth.uid
        && resource.data.isAdmin == true;

      // Admin records cannot be created, edited or deleted
      // from the website.
      allow create, update, delete: if false;

      allow list: if false;
    }


    // Shared institute/document/message defaults; only verified administrators.
    match /instituteSettings/workspace {
      function settingsAdmin() {
        return request.auth != null
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.uid == request.auth.uid;
      }
      function bounded(v, low, high) { return v is string && v.size() >= low && v.size() <= high; }
      function institute(v) {
        return v is map && v.keys().hasOnly(['name','address','email','phone','phone2','website'])
          && bounded(v.name,2,100) && bounded(v.address,5,240) && bounded(v.email,3,180)
          && v.phone is string && v.phone.matches('^[0-9]{10}$')
          && v.phone2 is string && (v.phone2 == '' || v.phone2.matches('^[0-9]{10}$'))
          && bounded(v.website,8,200) && v.website.matches('^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[^ ]*)?$');
      }
      function documentStyle(v) {
        return v is map && v.keys().hasOnly(['colour','footer'])
          && v.colour is string && v.colour.matches('^#[a-fA-F0-9]{6}$') && bounded(v.footer,0,120);
      }
      function validSettings(d) {
        return d.keys().hasOnly(['institute','documents','messages','revision','updatedBy','updatedAt'])
          && institute(d.institute) && d.documents is map && d.documents.keys().hasOnly(['receipt','marks'])
          && documentStyle(d.documents.receipt) && documentStyle(d.documents.marks)
          && d.messages is map && d.messages.keys().hasOnly(['attendance','fee','admission'])
          && bounded(d.messages.attendance,0,1500) && bounded(d.messages.fee,0,1500) && bounded(d.messages.admission,0,1500)
          && d.revision is int && d.revision > 0 && d.revision < 1000000000
          && d.updatedBy == request.auth.uid && bounded(d.updatedAt,20,40);
      }
      allow get: if settingsAdmin();
      allow create: if settingsAdmin() && validSettings(request.resource.data) && request.resource.data.revision == 1;
      allow update: if settingsAdmin() && validSettings(request.resource.data) && request.resource.data.revision == resource.data.revision + 1;
      allow list, delete: if false;
    }

    // Private shared signature images; administrators only, never public assets.
    match /instituteSettings/markCardSignatures {
      function signatureAdmin() {
        return request.auth != null
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.uid == request.auth.uid;
      }
      function validSignature(value) {
        return value is string && value.size() <= 220000
          && (value == "" || value.matches('^data:image/png;base64,[A-Za-z0-9+/]+={0,2}$'));
      }
      allow get: if signatureAdmin();
      allow create, update: if signatureAdmin()
        && request.resource.data.keys().hasOnly(["examiner", "authorized", "updatedAt", "updatedBy"])
        && validSignature(request.resource.data.examiner)
        && validSignature(request.resource.data.authorized)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
      allow list, delete: if false;
    }

    // Private approval PIN verifier for fee concessions. The PIN itself is never stored.
    match /instituteSettings/feeApprovalPin {
      function growthAdmin() {
        return request.auth != null
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.uid == request.auth.uid;
      }
      allow get: if growthAdmin();
      allow create, update: if growthAdmin()
        && request.resource.data.keys().hasOnly(['salt','hash','updatedAt','updatedBy'])
        && request.resource.data.salt is string && request.resource.data.salt.size() >= 16 && request.resource.data.salt.size() <= 80
        && request.resource.data.hash is string && request.resource.data.hash.matches('^[a-f0-9]{64}$')
        && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() >= 20 && request.resource.data.updatedAt.size() <= 40
        && request.resource.data.updatedBy == request.auth.uid;
      allow list, delete: if false;
    }

    match /growthProspects/{entryId} {
      function prospectAdmin() { return request.auth != null && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.uid == request.auth.uid; }
      function prospectValid(d) { return d.keys().hasOnly(['name','phone','course','visitDate','followUpDate','status','source','notes','revision','createdAt','createdBy','updatedAt','updatedBy'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 120 && d.phone is string && d.phone.matches('^[0-9]{10}$') && d.course is string && d.course.size() >= 1 && d.course.size() <= 140
        && d.visitDate is string && d.visitDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.followUpDate is string && (d.followUpDate == '' || d.followUpDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && d.status is string && d.status in ['Interested','Joining','Follow up later','No response','Not joining','Admitted'] && d.source is string && d.source.size() >= 2 && d.source.size() <= 80 && d.notes is string && d.notes.size() <= 800
        && d.revision is int && d.revision > 0 && d.revision < 1000000000 && d.createdBy is string && d.createdAt is string
        && d.updatedBy == request.auth.uid && d.updatedAt is string; }
      allow read: if verifiedAdmin();allow create: if verifiedAdmin() && prospectValid(request.resource.data) && request.resource.data.revision == 1;
      allow update: if verifiedAdmin() && prospectValid(request.resource.data) && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    match /growthIncome/{entryId} {
      function incomeAdmin() { return request.auth != null && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.uid == request.auth.uid; }
      function incomeValid(d) { return d.keys().hasOnly(['date','amount','category','method','reference','note','revision','createdAt','createdBy','updatedAt','updatedBy'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.amount is int && d.amount > 0 && d.amount < 100000000000
        && d.category is string && d.category.size() >= 2 && d.category.size() <= 80 && d.method is string && d.method in ['Cash','UPI','Bank transfer','Online / other'] && d.reference is string && d.reference.size() <= 120 && d.note is string && d.note.size() <= 500
        && d.revision is int && d.revision > 0 && d.createdBy is string && d.createdAt is string && d.updatedBy == request.auth.uid && d.updatedAt is string; }
      allow read: if verifiedAdmin();allow create: if verifiedAdmin() && incomeValid(request.resource.data) && request.resource.data.revision == 1;
      allow update: if verifiedAdmin() && incomeValid(request.resource.data) && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    match /growthLeagues/{entryId} {
      function leagueAdmin() { return request.auth != null && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.uid == request.auth.uid; }
      function leagueValid(d) { return d.keys().hasOnly(['title','date','category','count','top','improve','revision','createdAt','createdBy','updatedAt','updatedBy'])
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 120 && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.category in ['Boys','Girls'] && d.count is int && d.count >= 3 && d.count <= 20 && d.top is list && d.top.size() <= 20 && d.improve is list && d.improve.size() <= 20
        && d.revision is int && d.revision > 0 && d.createdBy is string && d.createdAt is string && d.updatedBy == request.auth.uid && d.updatedAt is string; }
      allow read: if verifiedAdmin();allow create: if verifiedAdmin() && leagueValid(request.resource.data) && request.resource.data.revision == 1;
      allow update: if verifiedAdmin() && leagueValid(request.resource.data) && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    // Shared tuition receipt sequence. No public access and no student data here.
    match /receiptCounters/tuition {
      function counterAdmin() {
        return request.auth != null
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.uid == request.auth.uid;
      }
      allow get: if counterAdmin();
      allow create: if counterAdmin()
        && request.resource.data.keys().hasOnly(["last"])
        && request.resource.data.last is int
        && request.resource.data.last == 1000;
      allow update: if counterAdmin()
        && request.resource.data.keys().hasOnly(["last"])
        && request.resource.data.last is int
        // Allow an unchanged value so stale optimistic transactions can reach
        // their version precondition and retry; the application increments once.
        && request.resource.data.last >= resource.data.last
        && request.resource.data.last <= resource.data.last + 1
        && request.resource.data.last <= 9999999;
      allow list, delete: if false;
    }

    /*
     * APPLICATIONS
     */

    match /applications/{applicationId} {

      /*
       * Public application fields.
       *
       * Only these fields may be submitted by a non-admin.
       * This prevents a public user from injecting privileged
       * fields such as admissionNumber, approvedAt, channel,
       * or arbitrary admin fields.
       */
      function hasOnlyPublicFields(d) {
        return d.keys().hasOnly([
          "fullName",
          "gender",
          "parentName",
          "phone",
          "guardianPhone",
          "email",
          "dob",
          "qualification",
          "address",
          "coursePreference",
          "batch",
          "source",
          "message",
          "paymentToken",
          "aadhaarLast4",
          "photo",
          "attendanceSetup",
          "attendanceEmail",
          "attendanceUid",
          "payment",
          "status",
          "createdAt"
        ]);
      }


      /*
       * Validate an optional string field.
       *
       * The field may be absent. If present, it must be a string
       * within the specified length range.
       */
      function strLen(d, key, minLen, maxLen) {
        return !(key in d)
          || (
            d[key] is string
            && d[key].size() >= minLen
            && d[key].size() <= maxLen
          );
      }


      /*
       * The public website currently creates a payment object
       * with status "awaiting".
       *
       * Public users must not be able to create a paid/verified
       * payment record.
       */
      function isPublicPayment(d) {
        return d.payment is map
          && d.payment.keys().hasOnly([
            "status",
            "amount"
          ])
          && d.payment.status == "awaiting"
          && d.payment.amount is number
          && d.payment.amount == 100;
      }


      /*
       * Hardened public application creation.
       */
      function isPublicApplicationCreate(d) {

        return hasOnlyPublicFields(d)

          // Public applications may start as New or Pending Payment.
          && (d.get("status", "") == "New"
              || d.get("status", "") == "Pending Payment")

          // Payment, if present, must be the harmless
          // "awaiting" payment state used by the website.
          && (!("payment" in d) || isPublicPayment(d))

          // Required fields.
          && d.fullName is string
          && d.fullName.size() >= 2
          && d.fullName.size() <= 120

          && d.phone is string
          && d.phone.size() == 10
          && d.phone.matches('^[0-9]{10}$')

          && d.coursePreference is string
          && d.coursePreference.size() >= 1
          && d.coursePreference.size() <= 120

          // Optional/user-provided fields.
          // Optional for older forms and records; this does not grant payment privileges.
          && (!("gender" in d) || d.gender in ["", "male", "female", "other", "prefer_not_to_say"])
          && strLen(d, "parentName", 0, 120)
          && strLen(d, "guardianPhone", 0, 20)
          && strLen(d, "email", 0, 254)
          && strLen(d, "dob", 0, 24)
          && strLen(d, "qualification", 0, 64)
          && strLen(d, "address", 0, 300)
          && strLen(d, "batch", 0, 40)
          && strLen(d, "source", 0, 120)
          && strLen(d, "message", 0, 5000)
          && strLen(d, "paymentToken", 16, 64)
          && strLen(d, "aadhaarLast4", 4, 4)
          && (!("aadhaarLast4" in d)
              || d.aadhaarLast4.matches("^[0-9]{4}$"))
          && strLen(d, "photo", 0, 800000)
          && (!("photo" in d) || d.photo == ""
              || d.photo.matches('^data:image/(jpeg|jpg|png|webp);base64,[A-Za-z0-9+/]+={0,2}$')
              || (d.photo.size() <= 2048
                  && d.photo.matches('^https://res[.]cloudinary[.]com/salatmdv/image/authenticated/v[0-9]{1,15}/student-photos/[0-9a-f-]{36}[.]jpg$')))
          && strLen(d, "attendanceSetup", 0, 16)
          && strLen(d, "attendanceEmail", 0, 254)
          && strLen(d, "attendanceUid", 0, 128)

          // The current website writes createdAt as an ISO string.
          && strLen(d, "createdAt", 0, 40);
      }


      /*
       * Only authorized administrators can read applications.
       */
      allow read: if
        request.auth != null
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.isAdmin == true
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.uid == request.auth.uid;


      /*
       * Public users can create only a properly validated
       * "New" application.
       *
       * Administrators can create applications for offline
       * walk-in enrollment.
       */
      allow create: if
        (
          request.auth != null
          && get(
            /databases/$(database)/documents/admins/$(request.auth.uid)
          ).data.isAdmin == true
          && get(
            /databases/$(database)/documents/admins/$(request.auth.uid)
          ).data.uid == request.auth.uid
        )
        || isPublicApplicationCreate(request.resource.data);


      /*
       * Only authorized administrators can edit or delete
       * applications.
       */
      allow update, delete: if
        request.auth != null
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.isAdmin == true
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.uid == request.auth.uid;
    }

    // A student-owned, sanitized copy of approved fields. The full application
    // remains admin-only. Students cannot list views or change any value.
    match /studentPortalViews/{studentUid} {
      function portalAdmin() {
        return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && verifiedAdmin();
      }
      function validView(d) {
        return d.keys().hasOnly(['uid','applicationId','enabled','profile','fees','attendance','journey','updatedAt'])
          && d.keys().hasAll(['uid','applicationId','enabled','profile','fees','attendance','journey','updatedAt'])
          && d.uid == studentUid
          && d.applicationId is string && d.applicationId.size() >= 1 && d.applicationId.size() <= 160
          && d.enabled is bool
          && d.profile is map && d.fees is map && d.attendance is list && d.journey is map
          && d.updatedAt is string && d.updatedAt.size() >= 20 && d.updatedAt.size() <= 40;
      }
      allow get: if portalAdmin() || (
        request.auth != null && request.auth.uid == studentUid && resource.data.enabled == true
      );
      allow list: if portalAdmin();
      allow create, update: if portalAdmin() && validView(request.resource.data);
      allow delete: if portalAdmin();

      // Published notes and images are scoped to one enabled student view.
      match /updates/{updateId} {
        function admin() {
          return request.auth != null
            && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && verifiedAdmin();
        }
        function student() {
          return request.auth != null && request.auth.uid == studentUid
            && get(/databases/$(database)/documents/studentPortalViews/$(studentUid)).data.enabled == true;
        }
        function validUpdate(d) {
          return d.keys().hasOnly(['category','title','details','author','createdAt','image','readByStudent','savedByStudent'])
            && d.keys().hasAll(['category','title','details','author','createdAt','image','readByStudent','savedByStudent'])
            && d.category in ['Class notes','Homework','Announcements','Exams','Results','Holidays']
            && d.title is string && d.title.size() >= 2 && d.title.size() <= 120
            && d.details is string && d.details.size() >= 1 && d.details.size() <= 5000
            && d.author is string && d.author.size() >= 2 && d.author.size() <= 100
            && d.createdAt is string && d.createdAt.size() >= 20 && d.createdAt.size() <= 40
            && d.image is string && d.image.size() <= 350000
            && (d.image == '' || d.image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$'))
            && d.readByStudent is bool && d.savedByStudent is bool;
        }
        allow get, list: if admin() || student();
        allow create: if admin() && validUpdate(request.resource.data);
        allow update: if (admin() && validUpdate(request.resource.data)) || (
          student() && validUpdate(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByStudent','savedByStudent'])
          && (request.resource.data.readByStudent == resource.data.readByStudent || request.resource.data.readByStudent == true)
        );
        allow delete: if admin();
      }
      match /messages/{messageId} {
        function admin() {
          return request.auth != null
            && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && verifiedAdmin();
        }
        function student() {
          return request.auth != null && request.auth.uid == studentUid
            && get(/databases/$(database)/documents/studentPortalViews/$(studentUid)).data.enabled == true;
        }
        function validMessage(d) {
          return d.keys().hasOnly(['sender','text','createdAt','readByStudent','readByAdmin'])
            && d.keys().hasAll(['sender','text','createdAt','readByStudent','readByAdmin'])
            && d.sender in ['student','admin']
            && d.text is string && d.text.size() >= 1 && d.text.size() <= 1500
            && d.createdAt is timestamp
            && d.readByStudent is bool && d.readByAdmin is bool;
        }
        allow get, list: if admin() || student();
        allow create: if validMessage(request.resource.data) && (
          admin() && request.resource.data.sender == 'admin'
            && request.resource.data.readByAdmin == true
            && request.resource.data.readByStudent == false
          || student() && request.resource.data.sender == 'student'
            && request.resource.data.readByStudent == true
            && request.resource.data.readByAdmin == false
        ) && request.resource.data.createdAt == request.time;
        allow update: if validMessage(request.resource.data) && (
          admin() && resource.data.sender == 'student'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByAdmin'])
            && request.resource.data.readByAdmin == true
          || student() && resource.data.sender == 'admin'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByStudent'])
            && request.resource.data.readByStudent == true
        );
        allow delete: if admin();
      }
      match /learning/current {
        function admin() {
          return request.auth != null
            && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && verifiedAdmin();
        }
        function student() {
          return request.auth != null && request.auth.uid == studentUid
            && get(/databases/$(database)/documents/studentPortalViews/$(studentUid)).data.enabled == true;
        }
        function validSelection(d) {
          return d.keys().hasOnly(['program','updatedAt'])
            && d.keys().hasAll(['program','updatedAt'])
            && d.program in ['Computer basics','Notepad','WordPad','MS Word','MS Excel','PowerPoint','MS Access','Outlook','Marg ERP','Tally Prime','Photoshop','InPage']
            && d.updatedAt == request.time;
        }
        allow get: if admin() || student();
        allow list: if false;
        allow create, update: if (admin() || student()) && validSelection(request.resource.data);
        allow delete: if admin();
      }
    }


    /* Server-created audit entries: only validated administrators may read.
     * No website client, including either admin, can write or remove history.
     */
    match /applicationAudit/{eventId} {
      function canReadAudit() {
        return request.auth != null
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.uid == request.auth.uid;
      }
      allow get: if canReadAudit();
      allow list: if canReadAudit() && request.query.limit != null && request.query.limit <= 100;
      allow create, update, delete: if false;
    }

    /*
     * Everything else is denied.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
