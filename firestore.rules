rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * ADMIN ACCESS
     *
     * Each administrator must have:
     * admins/{THEIR_FIREBASE_UID}
     *
     * with:
     * {
     *   uid: "THEIR_FIREBASE_UID",
     *   isAdmin: true
     * }
     */

    match /admins/{adminUid} {

      // An authenticated user can only read their own valid admin record.
      allow get: if
        request.auth != null
        && request.auth.uid == adminUid
        && resource.data.uid == request.auth.uid
        && resource.data.isAdmin == true;

      // Admin records cannot be created, edited or deleted
      // from the website.
      allow create, update, delete: if false;

      allow list: if false;
    }


    // Shared institute/document/message defaults; only verified administrators.
    match /instituteSettings/workspace {
      function settingsAdmin() {
        return request.auth != null
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.uid == request.auth.uid;
      }
      function bounded(v, low, high) { return v is string && v.size() >= low && v.size() <= high; }
      function institute(v) {
        return v is map && v.keys().hasOnly(['name','address','email','phone','phone2','website'])
          && bounded(v.name,2,100) && bounded(v.address,5,240) && bounded(v.email,3,180)
          && v.phone is string && v.phone.matches('^[0-9]{10}$')
          && v.phone2 is string && (v.phone2 == '' || v.phone2.matches('^[0-9]{10}$'))
          && bounded(v.website,8,200) && v.website.matches('^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[^ ]*)?$');
      }
      function documentStyle(v) {
        return v is map && v.keys().hasOnly(['colour','footer'])
          && v.colour is string && v.colour.matches('^#[a-fA-F0-9]{6}$') && bounded(v.footer,0,120);
      }
      function validSettings(d) {
        return d.keys().hasOnly(['institute','documents','messages','revision','updatedBy','updatedAt'])
          && institute(d.institute) && d.documents is map && d.documents.keys().hasOnly(['receipt','marks'])
          && documentStyle(d.documents.receipt) && documentStyle(d.documents.marks)
          && d.messages is map && d.messages.keys().hasOnly(['attendance','fee','admission'])
          && bounded(d.messages.attendance,0,1500) && bounded(d.messages.fee,0,1500) && bounded(d.messages.admission,0,1500)
          && d.revision is int && d.revision > 0 && d.revision < 1000000000
          && d.updatedBy == request.auth.uid && bounded(d.updatedAt,20,40);
      }
      allow get: if settingsAdmin();
      allow create: if settingsAdmin() && validSettings(request.resource.data) && request.resource.data.revision == 1;
      allow update: if settingsAdmin() && validSettings(request.resource.data) && request.resource.data.revision == resource.data.revision + 1;
      allow list, delete: if false;
    }

    // Private shared signature images; administrators only, never public assets.
    match /instituteSettings/markCardSignatures {
      function signatureAdmin() {
        return request.auth != null
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.uid == request.auth.uid;
      }
      function validSignature(value) {
        return value is string && value.size() <= 220000
          && (value == "" || value.matches('^data:image/png;base64,[A-Za-z0-9+/]+={0,2}$'));
      }
      allow get: if signatureAdmin();
      allow create, update: if signatureAdmin()
        && request.resource.data.keys().hasOnly(["examiner", "authorized", "updatedAt", "updatedBy"])
        && validSignature(request.resource.data.examiner)
        && validSignature(request.resource.data.authorized)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
      allow list, delete: if false;
    }

    // Shared tuition receipt sequence. No public access and no student data here.
    match /receiptCounters/tuition {
      function counterAdmin() {
        return request.auth != null
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.uid == request.auth.uid;
      }
      allow get: if counterAdmin();
      allow create: if counterAdmin()
        && request.resource.data.keys().hasOnly(["last"])
        && request.resource.data.last is int
        && request.resource.data.last == 1000;
      allow update: if counterAdmin()
        && request.resource.data.keys().hasOnly(["last"])
        && request.resource.data.last is int
        // Allow an unchanged value so stale optimistic transactions can reach
        // their version precondition and retry; the application increments once.
        && request.resource.data.last >= resource.data.last
        && request.resource.data.last <= resource.data.last + 1
        && request.resource.data.last <= 9999999;
      allow list, delete: if false;
    }

    /*
     * APPLICATIONS
     */

    match /applications/{applicationId} {

      /*
       * Public application fields.
       *
       * Only these fields may be submitted by a non-admin.
       * This prevents a public user from injecting privileged
       * fields such as admissionNumber, approvedAt, channel,
       * or arbitrary admin fields.
       */
      function hasOnlyPublicFields(d) {
        return d.keys().hasOnly([
          "fullName",
          "gender",
          "parentName",
          "phone",
          "guardianPhone",
          "email",
          "dob",
          "qualification",
          "address",
          "coursePreference",
          "batch",
          "source",
          "message",
          "paymentToken",
          "aadhaarLast4",
          "photo",
          "attendanceSetup",
          "attendanceEmail",
          "attendanceUid",
          "payment",
          "status",
          "createdAt"
        ]);
      }


      /*
       * Validate an optional string field.
       *
       * The field may be absent. If present, it must be a string
       * within the specified length range.
       */
      function strLen(d, key, minLen, maxLen) {
        return !(key in d)
          || (
            d[key] is string
            && d[key].size() >= minLen
            && d[key].size() <= maxLen
          );
      }


      /*
       * The public website currently creates a payment object
       * with status "awaiting".
       *
       * Public users must not be able to create a paid/verified
       * payment record.
       */
      function isPublicPayment(d) {
        return d.payment is map
          && d.payment.keys().hasOnly([
            "status",
            "amount"
          ])
          && d.payment.status == "awaiting"
          && d.payment.amount is number
          && d.payment.amount == 100;
      }


      /*
       * Hardened public application creation.
       */
      function isPublicApplicationCreate(d) {

        return hasOnlyPublicFields(d)

          // Public applications may start as New or Pending Payment.
          && (d.get("status", "") == "New"
              || d.get("status", "") == "Pending Payment")

          // Payment, if present, must be the harmless
          // "awaiting" payment state used by the website.
          && (!("payment" in d) || isPublicPayment(d))

          // Required fields.
          && d.fullName is string
          && d.fullName.size() >= 2
          && d.fullName.size() <= 120

          && d.phone is string
          && d.phone.size() == 10
          && d.phone.matches('^[0-9]{10}$')

          && d.coursePreference is string
          && d.coursePreference.size() >= 1
          && d.coursePreference.size() <= 120

          // Optional/user-provided fields.
          // Optional for older forms and records; this does not grant payment privileges.
          && (!("gender" in d) || d.gender in ["", "male", "female", "other", "prefer_not_to_say"])
          && strLen(d, "parentName", 0, 120)
          && strLen(d, "guardianPhone", 0, 20)
          && strLen(d, "email", 0, 254)
          && strLen(d, "dob", 0, 24)
          && strLen(d, "qualification", 0, 64)
          && strLen(d, "address", 0, 300)
          && strLen(d, "batch", 0, 40)
          && strLen(d, "source", 0, 120)
          && strLen(d, "message", 0, 5000)
          && strLen(d, "paymentToken", 16, 64)
          && strLen(d, "aadhaarLast4", 4, 4)
          && (!("aadhaarLast4" in d)
              || d.aadhaarLast4.matches("^[0-9]{4}$"))
          && strLen(d, "photo", 0, 800000)
          && (!("photo" in d) || d.photo == ""
              || d.photo.matches('^data:image/(jpeg|jpg|png|webp);base64,[A-Za-z0-9+/]+={0,2}$')
              || (d.photo.size() <= 2048
                  && d.photo.matches('^https://res[.]cloudinary[.]com/salatmdv/image/authenticated/v[0-9]{1,15}/student-photos/[0-9a-f-]{36}[.]jpg$')))
          && strLen(d, "attendanceSetup", 0, 16)
          && strLen(d, "attendanceEmail", 0, 254)
          && strLen(d, "attendanceUid", 0, 128)

          // The current website writes createdAt as an ISO string.
          && strLen(d, "createdAt", 0, 40);
      }


      /*
       * Only authorized administrators can read applications.
       */
      allow read: if
        request.auth != null
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.isAdmin == true
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.uid == request.auth.uid;


      /*
       * Public users can create only a properly validated
       * "New" application.
       *
       * Administrators can create applications for offline
       * walk-in enrollment.
       */
      allow create: if
        (
          request.auth != null
          && get(
            /databases/$(database)/documents/admins/$(request.auth.uid)
          ).data.isAdmin == true
          && get(
            /databases/$(database)/documents/admins/$(request.auth.uid)
          ).data.uid == request.auth.uid
        )
        || isPublicApplicationCreate(request.resource.data);


      /*
       * Only authorized administrators can edit or delete
       * applications.
       */
      allow update, delete: if
        request.auth != null
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.isAdmin == true
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.uid == request.auth.uid;
    }


    /*
     * Everything else is denied.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
